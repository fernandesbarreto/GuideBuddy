// Privacy Policy
"privacy_title" = "PRIVACY POLICY - GUIDE BUDDY";
"privacy_intro" = "This Privacy Policy describes how the Guide Buddy application (\"App\"), developed by Pedro Henrique Nunes da Silveira Bezerra (CPF 076.052.684-24), located at Rua Nova da Mangueira, 782, Brazil, contact email petehnscompany@gmail.com, collects, uses, shares and protects user data.\n\nLast updated: January 27, 2025.";
"privacy_section_1_title" = "1. INFORMATION COLLECTED";
"privacy_section_1_text" = "When using Guide Buddy, we collect the following information:";
"privacy_section_1_1_title" = "1.1. Registration Data:";
"privacy_section_1_1_text" = "- User name\n- Preferred language (Portuguese, English or Spanish)\n- Theme preference (light, dark or system default)";
"privacy_section_1_2_title" = "1.2. Usage Data:";
"privacy_section_1_2_text" = "- Personal documents you add to the application (passport, receipts, etc.)\n- Chat history with the AI virtual assistant\n- Saved favorite locations (if the map feature is used)";
"privacy_section_1_3_title" = "1.3. Device Permissions:";
"privacy_section_1_3_text" = "- Location access: used to display maps and provide navigation information\n- Microphone access: used for voice recognition in conversations with the virtual assistant\n- Camera access: used to add documents through photography (when available)";
"privacy_section_2_title" = "2. PURPOSE OF PROCESSING";
"privacy_section_2_text" = "We use your personal data to:";
"privacy_section_2_1_title" = "2.1. Provide application features:";
"privacy_section_2_1_text" = "- Personalize your experience (language, theme)\n- Store your personal documents\n- Maintain chat history with the virtual assistant\n- Provide information about hospitals, clinics and UFPE services\n- Display maps and locations";
"privacy_section_2_2_title" = "2.2. Improve service:";
"privacy_section_2_2_text" = "- Analyze usage patterns to enhance features\n- Fix errors and bugs";
"privacy_section_3_title" = "3. LEGAL BASIS";
"privacy_section_3_text" = "Data processing is carried out based on:";
"privacy_section_3_1" = "3.1. Contract execution: to enable application features";
"privacy_section_3_2" = "3.2. Consent: for use of location, microphone and camera";
"privacy_section_3_3" = "3.3. Legitimate interest: for application improvement";
"privacy_section_4_title" = "4. DATA STORAGE";
"privacy_section_4_1_title" = "4.1. Exclusively Local Storage:";
"privacy_section_4_1_text" = "- ALL your data is stored ONLY on your device using SwiftData\n- Documents, chat history, preferences and any personal information are stored EXCLUSIVELY on your device\n- The developer does NOT have access to your personal data\n- We do NOT send your data to external servers\n- We do NOT collect your personal data";
"privacy_section_4_2_title" = "4.2. Third-Party Services:";
"privacy_section_4_2_text" = "- We use AI services (such as Google Gemini) to process your questions in the chat\n- Only questions sent to the virtual assistant are processed by third-party services\n- Your personal documents, name, preferences and other data are NOT shared with third-party services";
"privacy_section_5_title" = "5. DATA SHARING";
"privacy_section_5_1" = "5.1. We do not sell, collect or have access to your personal data.";
"privacy_section_5_2_title" = "5.2. We only share information with:";
"privacy_section_5_2_text" = "- AI service providers for processing questions in the chat (only the question text)\n- Map services (Apple Maps) when you request navigation (only the location name)";
"privacy_section_5_3" = "5.3. Your personal documents, name, preferences and other personal data are NOT shared with third parties, as they remain exclusively on your device.";
"privacy_section_6_title" = "6. SECURITY";
"privacy_section_6_1_title" = "6.1. We implement security measures to protect your data:";
"privacy_section_6_1_text" = "- Encrypted local storage on the device\n- Secure communication (HTTPS) when using third-party services";
"privacy_section_6_2" = "6.2. However, no method of transmission or storage is 100% secure.";
"privacy_section_7_title" = "7. DATA RETENTION AND DELETION";
"privacy_section_7_1" = "7.1. Since all your data is stored exclusively on your device, the developer does not have access to it and therefore cannot delete it remotely.";
"privacy_section_7_2_title" = "7.2. You can delete your data at any time:";
"privacy_section_7_2_text" = "- By deleting the application from your device (all data will be automatically removed)\n- Or by manually deleting data through the application settings";
"privacy_section_7_3" = "7.3. IMPORTANT: Since data remains only on your phone, the developer cannot delete your data if you request it, as there is no remote access to data stored on your device.";
"privacy_section_8_title" = "8. YOUR RIGHTS (LGPD)";
"privacy_section_8_text" = "You have the right to:";
"privacy_section_8_1" = "8.1. Confirm the existence of data processing";
"privacy_section_8_2" = "8.2. Access your data";
"privacy_section_8_3" = "8.3. Correct incomplete, inaccurate or outdated data";
"privacy_section_8_4" = "8.4. Request anonymization, blocking or deletion of data";
"privacy_section_8_5" = "8.5. Revoke your consent";
"privacy_section_8_6" = "8.6. Request data portability";
"privacy_section_9_title" = "9. CONTACT";
"privacy_section_9_text" = "To clarify questions about this Privacy Policy, please contact:\n\nEmail: petehnscompany@gmail.com\nSubject: \"Privacy - Guide Buddy\"\n\nNOTE: Since data is stored exclusively on your device, it is not possible to fulfill requests for deletion or remote access to data. To delete your data, simply uninstall the application.";
"privacy_section_10_title" = "10. CHANGES";
"privacy_section_10_text" = "We reserve the right to update this Privacy Policy. The most recent version will always be available in the application, with the \"Last updated\" date indicated.";
"privacy_section_11_title" = "11. CONSENT";
"privacy_section_11_text" = "By using Guide Buddy, you declare that you have read, understood and agreed to this Privacy Policy.";

