// Política de Privacidade
"privacy_title" = "POLÍTICA DE PRIVACIDADE - GUIDE BUDDY";
"privacy_intro" = "Esta Política de Privacidade descreve como o aplicativo Guide Buddy (\"App\"), desenvolvido por Pedro Henrique Nunes da Silveira Bezerra (CPF 076.052.684-24), com sede em Rua Nova da Mangueira, 782, Brasil, e-mail de contato petehnscompany@gmail.com, coleta, utiliza, compartilha e protege os dados dos usuários.\n\nÚltima atualização: 27 de janeiro de 2025.";
"privacy_section_1_title" = "1. INFORMAÇÕES COLETADAS";
"privacy_section_1_text" = "Ao utilizar o Guide Buddy, coletamos as seguintes informações:";
"privacy_section_1_1_title" = "1.1. Dados de Cadastro:";
"privacy_section_1_1_text" = "- Nome do usuário\n- Idioma preferido (português, inglês ou espanhol)\n- Preferência de tema (claro, escuro ou padrão do sistema)";
"privacy_section_1_2_title" = "1.2. Dados de Uso:";
"privacy_section_1_2_text" = "- Documentos pessoais que você adiciona ao aplicativo (passaporte, comprovantes, etc.)\n- Histórico de conversas com o assistente virtual de IA\n- Localizações favoritas salvas (se utilizada a funcionalidade de mapas)";
"privacy_section_1_3_title" = "1.3. Permissões do Dispositivo:";
"privacy_section_1_3_text" = "- Acesso à localização: utilizado para exibir mapas e fornecer informações de navegação\n- Acesso ao microfone: utilizado para reconhecimento de voz nas conversas com o assistente virtual\n- Acesso à câmera: utilizado para adicionar documentos por meio de fotografia (quando disponível)";
"privacy_section_2_title" = "2. FINALIDADE DO TRATAMENTO";
"privacy_section_2_text" = "Utilizamos seus dados pessoais para:";
"privacy_section_2_1_title" = "2.1. Fornecer funcionalidades do aplicativo:";
"privacy_section_2_1_text" = "- Personalizar sua experiência (idioma, tema)\n- Armazenar seus documentos pessoais\n- Manter histórico de conversas com o assistente virtual\n- Fornecer informações sobre hospitais, clínicas e serviços da UFPE\n- Exibir mapas e localizações";
"privacy_section_2_2_title" = "2.2. Melhorar o serviço:";
"privacy_section_2_2_text" = "- Analisar padrões de uso para aprimorar funcionalidades\n- Corrigir erros e bugs";
"privacy_section_3_title" = "3. BASE LEGAL";
"privacy_section_3_text" = "O tratamento de dados é realizado com base em:";
"privacy_section_3_1" = "3.1. Execução de contrato: para viabilizar as funcionalidades do aplicativo";
"privacy_section_3_2" = "3.2. Consentimento: para uso de localização, microfone e câmera";
"privacy_section_3_3" = "3.3. Legítimo interesse: para aprimoramento do aplicativo";
"privacy_section_4_title" = "4. ARMAZENAMENTO DE DADOS";
"privacy_section_4_1_title" = "4.1. Armazenamento Exclusivamente Local:";
"privacy_section_4_1_text" = "- TODOS os seus dados são armazenados APENAS no seu dispositivo usando SwiftData\n- Documentos, histórico de conversas, preferências e qualquer informação pessoal ficam armazenados EXCLUSIVAMENTE no seu aparelho\n- O desenvolvedor NÃO tem acesso aos seus dados pessoais\n- NÃO enviamos seus dados para servidores externos\n- NÃO coletamos seus dados pessoais";
"privacy_section_4_2_title" = "4.2. Serviços de Terceiros:";
"privacy_section_4_2_text" = "- Utilizamos serviços de IA (como Google Gemini) para processar suas perguntas no chat\n- Apenas as perguntas enviadas ao assistente virtual são processadas por serviços de terceiros\n- Seus documentos pessoais, nome, preferências e outros dados NÃO são compartilhados com serviços de terceiros";
"privacy_section_5_title" = "5. COMPARTILHAMENTO DE DADOS";
"privacy_section_5_1" = "5.1. Não vendemos, não coletamos e não temos acesso aos seus dados pessoais.";
"privacy_section_5_2_title" = "5.2. Compartilhamos informações apenas com:";
"privacy_section_5_2_text" = "- Provedores de serviços de IA para processamento de perguntas no chat (apenas o texto da pergunta)\n- Serviços de mapas (Apple Maps) quando você solicita navegação (apenas o nome do local)";
"privacy_section_5_3" = "5.3. Seus documentos pessoais, nome, preferências e outros dados pessoais NÃO são compartilhados com terceiros, pois permanecem exclusivamente no seu dispositivo.";
"privacy_section_6_title" = "6. SEGURANÇA";
"privacy_section_6_1_title" = "6.1. Implementamos medidas de segurança para proteger seus dados:";
"privacy_section_6_1_text" = "- Armazenamento local criptografado no dispositivo\n- Comunicação segura (HTTPS) ao utilizar serviços de terceiros";
"privacy_section_6_2" = "6.2. No entanto, nenhum método de transmissão ou armazenamento é 100% seguro.";
"privacy_section_7_title" = "7. RETENÇÃO E EXCLUSÃO DE DADOS";
"privacy_section_7_1" = "7.1. Como todos os seus dados são armazenados exclusivamente no seu dispositivo, o desenvolvedor não tem acesso a eles e, portanto, não pode excluí-los remotamente.";
"privacy_section_7_2_title" = "7.2. Você pode excluir seus dados a qualquer momento:";
"privacy_section_7_2_text" = "- Excluindo o aplicativo do seu dispositivo (todos os dados serão removidos automaticamente)\n- Ou excluindo manualmente os dados através das configurações do aplicativo";
"privacy_section_7_3" = "7.3. IMPORTANTE: Como os dados ficam apenas no seu telefone, o desenvolvedor não pode apagar seus dados caso você solicite, pois não há acesso remoto aos dados armazenados no seu dispositivo.";
"privacy_section_8_title" = "8. SEUS DIREITOS (LGPD)";
"privacy_section_8_text" = "Você tem direito a:";
"privacy_section_8_1" = "8.1. Confirmar a existência de tratamento de dados";
"privacy_section_8_2" = "8.2. Acessar seus dados";
"privacy_section_8_3" = "8.3. Corrigir dados incompletos, inexatos ou desatualizados";
"privacy_section_8_4" = "8.4. Solicitar anonimização, bloqueio ou eliminação de dados";
"privacy_section_8_5" = "8.5. Revogar seu consentimento";
"privacy_section_8_6" = "8.6. Solicitar portabilidade dos dados";
"privacy_section_9_title" = "9. CONTATO";
"privacy_section_9_text" = "Para esclarecer dúvidas sobre esta Política de Privacidade, entre em contato:\n\nE-mail: petehnscompany@gmail.com\nAssunto: \"Privacidade - Guide Buddy\"\n\nNOTA: Como os dados são armazenados exclusivamente no seu dispositivo, não é possível atender solicitações de exclusão ou acesso remoto aos dados. Para excluir seus dados, basta desinstalar o aplicativo.";
"privacy_section_10_title" = "10. ALTERAÇÕES";
"privacy_section_10_text" = "Reservamo-nos o direito de atualizar esta Política de Privacidade. A versão mais recente estará sempre disponível no aplicativo, com a data de \"Última atualização\" indicada.";
"privacy_section_11_title" = "11. CONSENTIMENTO";
"privacy_section_11_text" = "Ao utilizar o Guide Buddy, você declara ter lido, compreendido e concordado com esta Política de Privacidade.";

