// Política de Privacidad
"privacy_title" = "POLÍTICA DE PRIVACIDAD - GUIDE BUDDY";
"privacy_intro" = "Esta Política de Privacidad describe cómo la aplicación Guide Buddy (\"App\"), desarrollada por Pedro Henrique Nunes da Silveira Bezerra (CPF 076.052.684-24), con sede en Rua Nova da Mangueira, 782, Brasil, correo electrónico de contacto petehnscompany@gmail.com, recopila, utiliza, comparte y protege los datos de los usuarios.\n\nÚltima actualización: 27 de enero de 2025.";
"privacy_section_1_title" = "1. INFORMACIÓN RECOPILADA";
"privacy_section_1_text" = "Al utilizar Guide Buddy, recopilamos la siguiente información:";
"privacy_section_1_1_title" = "1.1. Datos de Registro:";
"privacy_section_1_1_text" = "- Nombre del usuario\n- Idioma preferido (portugués, inglés o español)\n- Preferencia de tema (claro, oscuro o predeterminado del sistema)";
"privacy_section_1_2_title" = "1.2. Datos de Uso:";
"privacy_section_1_2_text" = "- Documentos personales que agregas a la aplicación (pasaporte, comprobantes, etc.)\n- Historial de conversaciones con el asistente virtual de IA\n- Ubicaciones favoritas guardadas (si se utiliza la funcionalidad de mapas)";
"privacy_section_1_3_title" = "1.3. Permisos del Dispositivo:";
"privacy_section_1_3_text" = "- Acceso a la ubicación: utilizado para mostrar mapas y proporcionar información de navegación\n- Acceso al micrófono: utilizado para reconocimiento de voz en conversaciones con el asistente virtual\n- Acceso a la cámara: utilizado para agregar documentos mediante fotografía (cuando esté disponible)";
"privacy_section_2_title" = "2. FINALIDAD DEL TRATAMIENTO";
"privacy_section_2_text" = "Utilizamos sus datos personales para:";
"privacy_section_2_1_title" = "2.1. Proporcionar funcionalidades de la aplicación:";
"privacy_section_2_1_text" = "- Personalizar su experiencia (idioma, tema)\n- Almacenar sus documentos personales\n- Mantener historial de conversaciones con el asistente virtual\n- Proporcionar información sobre hospitales, clínicas y servicios de la UFPE\n- Mostrar mapas y ubicaciones";
"privacy_section_2_2_title" = "2.2. Mejorar el servicio:";
"privacy_section_2_2_text" = "- Analizar patrones de uso para mejorar funcionalidades\n- Corregir errores y fallos";
"privacy_section_3_title" = "3. BASE LEGAL";
"privacy_section_3_text" = "El tratamiento de datos se realiza con base en:";
"privacy_section_3_1" = "3.1. Ejecución de contrato: para viabilizar las funcionalidades de la aplicación";
"privacy_section_3_2" = "3.2. Consentimiento: para uso de ubicación, micrófono y cámara";
"privacy_section_3_3" = "3.3. Interés legítimo: para mejora de la aplicación";
"privacy_section_4_title" = "4. ALMACENAMIENTO DE DATOS";
"privacy_section_4_1_title" = "4.1. Almacenamiento Exclusivamente Local:";
"privacy_section_4_1_text" = "- TODOS sus datos se almacenan SOLO en su dispositivo usando SwiftData\n- Documentos, historial de conversaciones, preferencias y cualquier información personal se almacenan EXCLUSIVAMENTE en su dispositivo\n- El desarrollador NO tiene acceso a sus datos personales\n- NO enviamos sus datos a servidores externos\n- NO recopilamos sus datos personales";
"privacy_section_4_2_title" = "4.2. Servicios de Terceros:";
"privacy_section_4_2_text" = "- Utilizamos servicios de IA (como Google Gemini) para procesar sus preguntas en el chat\n- Solo las preguntas enviadas al asistente virtual son procesadas por servicios de terceros\n- Sus documentos personales, nombre, preferencias y otros datos NO se comparten con servicios de terceros";
"privacy_section_5_title" = "5. COMPARTIR DATOS";
"privacy_section_5_1" = "5.1. No vendemos, no recopilamos y no tenemos acceso a sus datos personales.";
"privacy_section_5_2_title" = "5.2. Solo compartimos información con:";
"privacy_section_5_2_text" = "- Proveedores de servicios de IA para procesamiento de preguntas en el chat (solo el texto de la pregunta)\n- Servicios de mapas (Apple Maps) cuando solicita navegación (solo el nombre del lugar)";
"privacy_section_5_3" = "5.3. Sus documentos personales, nombre, preferencias y otros datos personales NO se comparten con terceros, ya que permanecen exclusivamente en su dispositivo.";
"privacy_section_6_title" = "6. SEGURIDAD";
"privacy_section_6_1_title" = "6.1. Implementamos medidas de seguridad para proteger sus datos:";
"privacy_section_6_1_text" = "- Almacenamiento local cifrado en el dispositivo\n- Comunicación segura (HTTPS) al utilizar servicios de terceros";
"privacy_section_6_2" = "6.2. Sin embargo, ningún método de transmisión o almacenamiento es 100% seguro.";
"privacy_section_7_title" = "7. RETENCIÓN Y ELIMINACIÓN DE DATOS";
"privacy_section_7_1" = "7.1. Como todos sus datos se almacenan exclusivamente en su dispositivo, el desarrollador no tiene acceso a ellos y, por lo tanto, no puede eliminarlos remotamente.";
"privacy_section_7_2_title" = "7.2. Puede eliminar sus datos en cualquier momento:";
"privacy_section_7_2_text" = "- Eliminando la aplicación de su dispositivo (todos los datos se eliminarán automáticamente)\n- O eliminando manualmente los datos a través de la configuración de la aplicación";
"privacy_section_7_3" = "7.3. IMPORTANTE: Como los datos permanecen solo en su teléfono, el desarrollador no puede eliminar sus datos si lo solicita, ya que no hay acceso remoto a los datos almacenados en su dispositivo.";
"privacy_section_8_title" = "8. SUS DERECHOS (LGPD)";
"privacy_section_8_text" = "Usted tiene derecho a:";
"privacy_section_8_1" = "8.1. Confirmar la existencia de tratamiento de datos";
"privacy_section_8_2" = "8.2. Acceder a sus datos";
"privacy_section_8_3" = "8.3. Corregir datos incompletos, inexactos o desactualizados";
"privacy_section_8_4" = "8.4. Solicitar anonimización, bloqueo o eliminación de datos";
"privacy_section_8_5" = "8.5. Revocar su consentimiento";
"privacy_section_8_6" = "8.6. Solicitar portabilidad de datos";
"privacy_section_9_title" = "9. CONTACTO";
"privacy_section_9_text" = "Para aclarar dudas sobre esta Política de Privacidad, póngase en contacto:\n\nCorreo electrónico: petehnscompany@gmail.com\nAsunto: \"Privacidad - Guide Buddy\"\n\nNOTA: Como los datos se almacenan exclusivamente en su dispositivo, no es posible atender solicitudes de eliminación o acceso remoto a los datos. Para eliminar sus datos, simplemente desinstale la aplicación.";
"privacy_section_10_title" = "10. CAMBIOS";
"privacy_section_10_text" = "Nos reservamos el derecho de actualizar esta Política de Privacidad. La versión más reciente estará siempre disponible en la aplicación, con la fecha de \"Última actualización\" indicada.";
"privacy_section_11_title" = "11. CONSENTIMIENTO";
"privacy_section_11_text" = "Al utilizar Guide Buddy, usted declara haber leído, comprendido y aceptado esta Política de Privacidad.";

